(* Pure IEC 61131-3 Structured Text for G9_TASK_04 *)
PROGRAM G9_TASK_04_Control
VAR
    T2_LEVEL_PV AT %R141 : REAL := 0.0;
    TANK_02_SETPOINT AT %R142 : REAL := 600.0;
    TANK_02_LOW_SP AT %R143 : REAL := 150.0;
    TANK_02_HIGH_SP AT %R144 : REAL := 850.0;
    SYS_AUTO_MODE AT %M71 : BOOL := TRUE;
    SYS_ESTOP_ACTIVE AT %I19 : BOOL := FALSE;
    T2_PRESS_INLET AT %Q23 : BOOL := FALSE;
    T2_PRESS_OUTLET AT %Q24 : BOOL := FALSE;
    T2_BOOSTER_PUMP AT %Q25 : BOOL := FALSE;
    ton_delay : TON;
END_VAR

(* Safety & Permissive *)
IF NOT SYS_ESTOP_ACTIVE AND SYS_AUTO_MODE THEN
    (* Level regulation *)
    IF T2_LEVEL_PV < TANK_02_SETPOINT THEN
        T2_PRESS_INLET := TRUE;
    ELSIF T2_LEVEL_PV >= TANK_02_HIGH_SP THEN
        T2_PRESS_INLET := FALSE;
    END_IF;

    (* Low level pump protection *)
    IF T2_LEVEL_PV <= TANK_02_LOW_SP THEN
        T2_BOOSTER_PUMP := FALSE;
    ELSE
        T2_BOOSTER_PUMP := TRUE;
    END_IF;
ELSE
    T2_PRESS_INLET := FALSE;
    T2_BOOSTER_PUMP := FALSE;
    T2_PRESS_OUTLET := FALSE;
END_IF;

ton_delay(IN := T2_PRESS_INLET, PT := T#4s);
END_PROGRAM
