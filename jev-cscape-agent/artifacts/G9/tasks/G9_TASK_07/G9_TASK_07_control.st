(* Pure IEC 61131-3 Structured Text for G9_TASK_07 *)
PROGRAM G9_TASK_07_Control
VAR
    T1_LEVEL_PV AT %R171 : REAL := 0.0;
    TANK_01_SETPOINT AT %R172 : REAL := 550.0;
    TANK_01_LOW_SP AT %R173 : REAL := 120.0;
    TANK_01_HIGH_SP AT %R174 : REAL := 920.0;
    SYS_AUTO_MODE AT %M86 : BOOL := TRUE;
    SYS_ESTOP_ACTIVE AT %I25 : BOOL := FALSE;
    T1_RECIRC_VALVE AT %Q35 : BOOL := FALSE;
    T1_BYPASS_VALVE AT %Q36 : BOOL := FALSE;
    T1_AGITATOR_PUMP AT %Q37 : BOOL := FALSE;
    ton_delay : TON;
END_VAR

(* Safety & Permissive *)
IF NOT SYS_ESTOP_ACTIVE AND SYS_AUTO_MODE THEN
    (* Level regulation *)
    IF T1_LEVEL_PV < TANK_01_SETPOINT THEN
        T1_RECIRC_VALVE := TRUE;
    ELSIF T1_LEVEL_PV >= TANK_01_HIGH_SP THEN
        T1_RECIRC_VALVE := FALSE;
    END_IF;

    (* Low level pump protection *)
    IF T1_LEVEL_PV <= TANK_01_LOW_SP THEN
        T1_AGITATOR_PUMP := FALSE;
    ELSE
        T1_AGITATOR_PUMP := TRUE;
    END_IF;
ELSE
    T1_RECIRC_VALVE := FALSE;
    T1_AGITATOR_PUMP := FALSE;
    T1_BYPASS_VALVE := FALSE;
END_IF;

ton_delay(IN := T1_RECIRC_VALVE, PT := T#7s);
END_PROGRAM
