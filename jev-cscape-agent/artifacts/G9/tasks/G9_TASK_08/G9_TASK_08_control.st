(* Pure IEC 61131-3 Structured Text for G9_TASK_08 *)
PROGRAM G9_TASK_08_Control
VAR
    CHEM_LEVEL_PV AT %R181 : REAL := 0.0;
    TANK_CHEM_SETPOINT AT %R182 : REAL := 350.0;
    TANK_CHEM_LOW_SP AT %R183 : REAL := 60.0;
    TANK_CHEM_HIGH_SP AT %R184 : REAL := 700.0;
    SYS_AUTO_MODE AT %M91 : BOOL := TRUE;
    SYS_ESTOP_ACTIVE AT %I27 : BOOL := FALSE;
    CHEM_DOSING_VALVE AT %Q39 : BOOL := FALSE;
    CHEM_FLUSH_VALVE AT %Q40 : BOOL := FALSE;
    CHEM_METER_PUMP AT %Q41 : BOOL := FALSE;
    ton_delay : TON;
END_VAR

(* Safety & Permissive *)
IF NOT SYS_ESTOP_ACTIVE AND SYS_AUTO_MODE THEN
    (* Level regulation *)
    IF CHEM_LEVEL_PV < TANK_CHEM_SETPOINT THEN
        CHEM_DOSING_VALVE := TRUE;
    ELSIF CHEM_LEVEL_PV >= TANK_CHEM_HIGH_SP THEN
        CHEM_DOSING_VALVE := FALSE;
    END_IF;

    (* Low level pump protection *)
    IF CHEM_LEVEL_PV <= TANK_CHEM_LOW_SP THEN
        CHEM_METER_PUMP := FALSE;
    ELSE
        CHEM_METER_PUMP := TRUE;
    END_IF;
ELSE
    CHEM_DOSING_VALVE := FALSE;
    CHEM_METER_PUMP := FALSE;
    CHEM_FLUSH_VALVE := FALSE;
END_IF;

ton_delay(IN := CHEM_DOSING_VALVE, PT := T#10s);
END_PROGRAM
