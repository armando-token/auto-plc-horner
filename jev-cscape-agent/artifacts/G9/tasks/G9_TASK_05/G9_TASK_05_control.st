(* Pure IEC 61131-3 Structured Text for G9_TASK_05 *)
PROGRAM G9_TASK_05_Control
VAR
    DUAL_AVG_LEVEL AT %R151 : REAL := 0.0;
    TANK_DUAL_SETPOINT AT %R152 : REAL := 450.0;
    TANK_DUAL_LOW_SP AT %R153 : REAL := 80.0;
    TANK_DUAL_HIGH_SP AT %R154 : REAL := 880.0;
    SYS_AUTO_MODE AT %M76 : BOOL := TRUE;
    SYS_ESTOP_ACTIVE AT %I21 : BOOL := FALSE;
    DUAL_TRANSFER_V AT %Q27 : BOOL := FALSE;
    DUAL_DRAIN_V AT %Q28 : BOOL := FALSE;
    DUAL_XFER_PUMP AT %Q29 : BOOL := FALSE;
    ton_delay : TON;
END_VAR

(* Safety & Permissive *)
IF NOT SYS_ESTOP_ACTIVE AND SYS_AUTO_MODE THEN
    (* Level regulation *)
    IF DUAL_AVG_LEVEL < TANK_DUAL_SETPOINT THEN
        DUAL_TRANSFER_V := TRUE;
    ELSIF DUAL_AVG_LEVEL >= TANK_DUAL_HIGH_SP THEN
        DUAL_TRANSFER_V := FALSE;
    END_IF;

    (* Low level pump protection *)
    IF DUAL_AVG_LEVEL <= TANK_DUAL_LOW_SP THEN
        DUAL_XFER_PUMP := FALSE;
    ELSE
        DUAL_XFER_PUMP := TRUE;
    END_IF;
ELSE
    DUAL_TRANSFER_V := FALSE;
    DUAL_XFER_PUMP := FALSE;
    DUAL_DRAIN_V := FALSE;
END_IF;

ton_delay(IN := DUAL_TRANSFER_V, PT := T#6s);
END_PROGRAM
