(* Pure IEC 61131-3 Structured Text for G9_TASK_10 *)
PROGRAM G9_TASK_10_Control
VAR
    SLURRY_LEVEL_PV AT %R201 : REAL := 0.0;
    TANK_SLURRY_SETPOINT AT %R202 : REAL := 420.0;
    TANK_SLURRY_LOW_SP AT %R203 : REAL := 90.0;
    TANK_SLURRY_HIGH_SP AT %R204 : REAL := 820.0;
    SYS_AUTO_MODE AT %M101 : BOOL := TRUE;
    SYS_ESTOP_ACTIVE AT %I31 : BOOL := FALSE;
    SLURRY_INLET_V AT %Q47 : BOOL := FALSE;
    SLURRY_PURGE_V AT %Q48 : BOOL := FALSE;
    SLURRY_CAVITY_PUMP AT %Q49 : BOOL := FALSE;
    ton_delay : TON;
END_VAR

(* Safety & Permissive *)
IF NOT SYS_ESTOP_ACTIVE AND SYS_AUTO_MODE THEN
    (* Level regulation *)
    IF SLURRY_LEVEL_PV < TANK_SLURRY_SETPOINT THEN
        SLURRY_INLET_V := TRUE;
    ELSIF SLURRY_LEVEL_PV >= TANK_SLURRY_HIGH_SP THEN
        SLURRY_INLET_V := FALSE;
    END_IF;

    (* Low level pump protection *)
    IF SLURRY_LEVEL_PV <= TANK_SLURRY_LOW_SP THEN
        SLURRY_CAVITY_PUMP := FALSE;
    ELSE
        SLURRY_CAVITY_PUMP := TRUE;
    END_IF;
ELSE
    SLURRY_INLET_V := FALSE;
    SLURRY_CAVITY_PUMP := FALSE;
    SLURRY_PURGE_V := FALSE;
END_IF;

ton_delay(IN := SLURRY_INLET_V, PT := T#9s);
END_PROGRAM
