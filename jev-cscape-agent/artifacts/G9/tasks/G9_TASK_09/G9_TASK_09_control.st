(* Pure IEC 61131-3 Structured Text for G9_TASK_09 *)
PROGRAM G9_TASK_09_Control
VAR
    CASCADE_LEVEL_PV AT %R191 : REAL := 0.0;
    TANK_CASCADE_SETPOINT AT %R192 : REAL := 650.0;
    TANK_CASCADE_LOW_SP AT %R193 : REAL := 180.0;
    TANK_CASCADE_HIGH_SP AT %R194 : REAL := 940.0;
    SYS_AUTO_MODE AT %M96 : BOOL := TRUE;
    SYS_ESTOP_ACTIVE AT %I29 : BOOL := FALSE;
    CASCADE_INLET_V AT %Q43 : BOOL := FALSE;
    CASCADE_DISCH_V AT %Q44 : BOOL := FALSE;
    CASCADE_STAGE_PUMP AT %Q45 : BOOL := FALSE;
    ton_delay : TON;
END_VAR

(* Safety & Permissive *)
IF NOT SYS_ESTOP_ACTIVE AND SYS_AUTO_MODE THEN
    (* Level regulation *)
    IF CASCADE_LEVEL_PV < TANK_CASCADE_SETPOINT THEN
        CASCADE_INLET_V := TRUE;
    ELSIF CASCADE_LEVEL_PV >= TANK_CASCADE_HIGH_SP THEN
        CASCADE_INLET_V := FALSE;
    END_IF;

    (* Low level pump protection *)
    IF CASCADE_LEVEL_PV <= TANK_CASCADE_LOW_SP THEN
        CASCADE_STAGE_PUMP := FALSE;
    ELSE
        CASCADE_STAGE_PUMP := TRUE;
    END_IF;
ELSE
    CASCADE_INLET_V := FALSE;
    CASCADE_STAGE_PUMP := FALSE;
    CASCADE_DISCH_V := FALSE;
END_IF;

ton_delay(IN := CASCADE_INLET_V, PT := T#4s);
END_PROGRAM
