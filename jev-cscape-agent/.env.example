# 1. TypeSafe SystemOne / JEV Remote Reasoning API
JEV_API_KEY=your_typesafe_jev_api_key_here
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# 2. Local Horner APG Cscape 10.2 Installation (Not Redistributed)
# Verify SHA-256 (4b82560db103b4f26a9163bee3ae29439712c1c69ccaac11d0e898e51dcde405)
CSCAPE_EXE_PATH="C:\Program Files (x86)\Cscape 10.2\Cscape.exe"
CSCAPE_BASELINE_CSP="work/disposable/p1_base.csp"

# 3. Fail-Closed Hardware Safety & Commissioning Lockout (G11 / G12)
# Do NOT alter without formal physical bench commissioning authorization.
JEV_HARDWARE_LOCKOUT=1
JEV_G12_BANK_STATUS=blocked
